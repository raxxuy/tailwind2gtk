{
  "name": "tailwind2gtk",
  "version": "0.1.4",
  "description": "A Tailwind-inspired utility class generator for GTK/AGS applications",
  "main": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
