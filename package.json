{
  "name": "tailwind2gtk",
  "version": "0.3.8",
  "description": "A Tailwind-inspired utility class generator for GTK/AGS applications",
  "main": "./index.ts",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./plugins/ags": "./src/plugins/ags.ts",
    "./plugins/node": "./src/plugins/node.ts"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "format": "biome format ./src"
  },
  "keywords": [
    "tailwind",
    "gtk",
    "ags",
    "scss",
    "utility-classes"
  ],
  "author": "raxxuy",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.6.0",
    "ags": "github:Aylur/ags",
    "vitest": "^4.1.5"
  }
}
